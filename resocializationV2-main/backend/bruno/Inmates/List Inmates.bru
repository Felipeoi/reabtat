meta {
  name: List Inmates
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/inmates?limit=10&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is an array", function() {
    expect(res.body).to.be.an('array');
  });
}
